# ============================================================
# LSTM-Based Traffic Volume Forecasting
# Smart City Transportation Management
#
# Dataset: Metro Interstate Traffic Volume
# Goal: Predict future hourly traffic volume using LSTM
# ============================================================

# Import the libraries we need
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.preprocessing import MinMaxScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error

from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import LSTM, Dense, Dropout
from tensorflow.keras.callbacks import EarlyStopping


# ------------------------------------------------------------
# 1. LOAD THE DATASET
# ------------------------------------------------------------

df = pd.read_csv("Metro_Interstate_Traffic_Volume.csv")

print("Dataset shape:", df.shape)
print("\nFirst few rows:")
print(df.head())


# ------------------------------------------------------------
# 2. BASIC DATA CLEANING
# ------------------------------------------------------------

# Convert the date/time column into proper datetime format
df["date_time"] = pd.to_datetime(df["date_time"])

# Sort everything chronologically
df = df.sort_values("date_time")

# Remove duplicate timestamps if there are any
df = df.drop_duplicates(subset=["date_time"])

# Traffic volume is our target variable
print("\nMissing values:")
print(df[["date_time", "traffic_volume"]].isnull().sum())

# Remove rows where traffic volume is missing
df = df.dropna(subset=["traffic_volume"])


# ------------------------------------------------------------
# 3. VISUALIZE TRAFFIC VOLUME
# ------------------------------------------------------------

plt.figure(figsize=(15, 5))

plt.plot(
    df["date_time"],
    df["traffic_volume"],
    linewidth=0.8
)

plt.title("Historical Hourly Traffic Volume")
plt.xlabel("Date")
plt.ylabel("Traffic Volume")
plt.grid(True)

plt.show()


# ------------------------------------------------------------
# 4. USE TRAFFIC VOLUME FOR THE LSTM
# ------------------------------------------------------------

# For this version, we use previous traffic observations
# to predict the next traffic observation.
#
# This keeps the LSTM easy to understand:
#
# Previous 24 hours ---> Next hour traffic volume
#
# Using 24 hours also allows the model to learn daily
# traffic patterns.

traffic = df[["traffic_volume"]].values


# ------------------------------------------------------------
# 5. SCALE THE DATA
# ------------------------------------------------------------

# Neural networks generally train better when values are
# in a smaller range such as 0 to 1.

scaler = MinMaxScaler(feature_range=(0, 1))

scaled_traffic = scaler.fit_transform(traffic)


# ------------------------------------------------------------
# 6. TRAIN-TEST SPLIT
# ------------------------------------------------------------

# We DON'T randomly split time-series data.
# The model should learn from the past and then be tested
# on future observations.

train_size = int(len(scaled_traffic) * 0.80)

train_data = scaled_traffic[:train_size]
test_data = scaled_traffic[train_size:]

print("\nTraining observations:", len(train_data))
print("Testing observations :", len(test_data))


# ------------------------------------------------------------
# 7. CREATE SEQUENCES FOR THE LSTM
# ------------------------------------------------------------

# We use the previous 24 hours to predict the next hour.

sequence_length = 24


def create_sequences(data, sequence_length):
    X = []
    y = []

    for i in range(sequence_length, len(data)):

        # Previous 24 hours
        X.append(
            data[i-sequence_length:i, 0]
        )

        # Traffic volume at the next hour
        y.append(
            data[i, 0]
        )

    return np.array(X), np.array(y)


X_train, y_train = create_sequences(
    train_data,
    sequence_length
)


# For the test set, we need the last 24 training observations
# so that the first test prediction still has historical context.

combined_data = np.concatenate(
    [train_data[-sequence_length:], test_data]
)

X_test, y_test = create_sequences(
    combined_data,
    sequence_length
)


# LSTM expects:
# samples × time steps × features

X_train = X_train.reshape(
    X_train.shape[0],
    X_train.shape[1],
    1
)

X_test = X_test.reshape(
    X_test.shape[0],
    X_test.shape[1],
    1
)

print("\nX_train shape:", X_train.shape)
print("X_test shape :", X_test.shape)


# ------------------------------------------------------------
# 8. BUILD THE LSTM MODEL
# ------------------------------------------------------------

model = Sequential()

# First LSTM layer learns patterns across the 24-hour sequence
model.add(
    LSTM(
        64,
        return_sequences=True,
        input_shape=(sequence_length, 1)
    )
)

# Dropout helps reduce overfitting
model.add(Dropout(0.2))

# Second LSTM layer learns higher-level temporal patterns
model.add(
    LSTM(32)
)

model.add(Dropout(0.2))

# Fully connected layer
model.add(
    Dense(16, activation="relu")
)

# One output because we are predicting one traffic value
model.add(
    Dense(1)
)


# ------------------------------------------------------------
# 9. COMPILE THE MODEL
# ------------------------------------------------------------

model.compile(
    optimizer="adam",
    loss="mean_squared_error"
)

print("\nModel architecture:")
model.summary()


# ------------------------------------------------------------
# 10. TRAIN THE MODEL
# ------------------------------------------------------------

# Stop training if validation performance stops improving.
# This saves time and helps prevent overfitting.

early_stopping = EarlyStopping(
    monitor="val_loss",
    patience=7,
    restore_best_weights=True
)

history = model.fit(
    X_train,
    y_train,
    epochs=40,
    batch_size=32,
    validation_split=0.1,
    callbacks=[early_stopping],
    verbose=1
)


# ------------------------------------------------------------
# 11. PLOT TRAINING AND VALIDATION LOSS
# ------------------------------------------------------------

plt.figure(figsize=(10, 5))

plt.plot(
    history.history["loss"],
    label="Training Loss"
)

plt.plot(
    history.history["val_loss"],
    label="Validation Loss"
)

plt.title("LSTM Training vs Validation Loss")
plt.xlabel("Epoch")
plt.ylabel("MSE Loss")
plt.legend()
plt.grid(True)

plt.show()


# ------------------------------------------------------------
# 12. MAKE PREDICTIONS
# ------------------------------------------------------------

predictions = model.predict(
    X_test,
    verbose=0
)


# The model predicted scaled values between 0 and 1.
# Convert them back to actual traffic volume.

predicted_traffic = scaler.inverse_transform(
    predictions
).flatten()

actual_traffic = scaler.inverse_transform(
    y_test.reshape(-1, 1)
).flatten()


# ------------------------------------------------------------
# 13. EVALUATE THE MODEL
# ------------------------------------------------------------

# MAE tells us the average absolute prediction error.
mae = mean_absolute_error(
    actual_traffic,
    predicted_traffic
)

# RMSE gives more importance to large errors.
rmse = np.sqrt(
    mean_squared_error(
        actual_traffic,
        predicted_traffic
    )
)

# Calculate MAPE carefully.
# We remove zero actual values because MAPE involves
# division by the actual value.

non_zero = actual_traffic != 0

mape = np.mean(
    np.abs(
        (actual_traffic[non_zero] -
         predicted_traffic[non_zero])
        / actual_traffic[non_zero]
    )
) * 100


print("\n========================================")
print("       LSTM MODEL PERFORMANCE")
print("========================================")

print(f"MAE  : {mae:.2f} vehicles/hour")
print(f"RMSE : {rmse:.2f} vehicles/hour")
print(f"MAPE : {mape:.2f}%")


# ------------------------------------------------------------
# 14. ACTUAL VS PREDICTED TRAFFIC
# ------------------------------------------------------------

# Plot a manageable portion of the test data so the graph
# remains readable.

plot_points = min(500, len(actual_traffic))

plt.figure(figsize=(15, 6))

plt.plot(
    actual_traffic[:plot_points],
    label="Actual Traffic"
)

plt.plot(
    predicted_traffic[:plot_points],
    label="Predicted Traffic"
)

plt.title(
    "Actual vs Predicted Traffic Volume"
)

plt.xlabel("Test Time Steps")
plt.ylabel("Traffic Volume")

plt.legend()
plt.grid(True)

plt.show()


# ------------------------------------------------------------
# 15. PREDICT THE NEXT HOUR
# ------------------------------------------------------------

# Take the most recent 24 hours
last_24_hours = scaled_traffic[-sequence_length:]

# Reshape it into the format expected by the LSTM
last_24_hours = last_24_hours.reshape(
    1,
    sequence_length,
    1
)

# Predict traffic for the next hour
next_hour_scaled = model.predict(
    last_24_hours,
    verbose=0
)

# Convert prediction back to the original scale
next_hour_traffic = scaler.inverse_transform(
    next_hour_scaled
)[0][0]


print("\n========================================")
print("        NEXT-HOUR FORECAST")
print("========================================")

print(
    f"Predicted traffic volume for the next hour: "
    f"{next_hour_traffic:.0f} vehicles"
)
